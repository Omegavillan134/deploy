{
  "name": "cvsu-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "fix": "node scripts/fix.mjs",
    "check": "npm run doctor && npm run typecheck && npm run lint && npm run test",
    "postinstall": "prisma generate",
    "db:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.52.0",
    "zod": "3.23.8",
    "@hookform/resolvers": "3.9.0",
    "@prisma/client": "5.17.0",
    "argon2": "0.40.3"
  },
  "devDependencies": {
    "typescript": "5.5.3",
    "@types/react": "18.3.3",
    "@types/node": "20.14.0",
    "tailwindcss": "3.4.6",
    "postcss": "8.4.39",
    "autoprefixer": "10.4.19",
    "prisma": "5.17.0",
    "tsx": "4.16.0",
    "vitest": "2.0.5",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
